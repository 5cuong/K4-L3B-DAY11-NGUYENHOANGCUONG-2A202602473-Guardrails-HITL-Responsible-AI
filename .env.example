# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit file .env lên GitHub.

# =============================================================================
# BLUE AGENT (CP2–CP3) — CỐ ĐỊNH OpenRouter liquid/lfm-2.5-2.6b
# Model cố định trong code; chỉ cần API key.
# https://openrouter.ai/liquid/lfm-2.5-2.6b
# =============================================================================
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =============================================================================
# RED AGENT (CP4) — default + advance dùng cùng provider
# Chọn MỘT: openai (gpt-4o-mini) hoặc gemini (gemini-3.5-flash)
# =============================================================================
RED_TEAM_PROVIDER=openai
# RED_TEAM_PROVIDER=gemini

# --- Nếu Red Agent = openai ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Khó hơn (bonus B1 khi tấn công Red Agent default):
# OPENAI_MODEL=gpt-5.6-luna

# --- Nếu Red Agent = gemini ---
# GOOGLE_API_KEY=your-google-ai-studio-key-here
# GOOGLE_GENAI_USE_VERTEXAI=0
# GEMINI_MODEL=gemini-3.5-flash
# Khó hơn (bonus B1 khi tấn công Red Agent default):
# GEMINI_MODEL=gemini-3.8-flash

# STUDENT_ID=2A2026xxxxx
